---
// src/components/Home.astro — hero (input-as-hero) + grid de módulos, locale-aware.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { modules } from '../lib/modules';
import { getLocale, useTranslations } from '../i18n/ui';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const items = modules.map((m) => ({
  id: m.id,
  href: getRelativeLocaleUrl(locale, m.slugs[locale]),
  label: t(`tool.${m.id}.label`),
  description: t(`tool.${m.id}.desc`),
}));
// Chips de sugerencia bajo el lanzador (el resto vive en el grid y en ⌘K): una
// selección destacada por id, no las primeras del grid, que ya se ven debajo.
const FEATURED = ['calco', 'csv', 'gradiente', 'naming', 'units'];
const featured = FEATURED.map((id) => items.find((i) => i.id === id)!);
---

<main class="home">
  {/* Above-fold: lienzo crema casi vacío; el lanzador es el héroe, no un titular. */}
  <section class="hero">
    <p class="hero__eyebrow">{t('home.eyebrow', { n: modules.length })}</p>
    <h1 class="hero__title">{t('home.title')}</h1>

    {/* El ⌘K de Deftkit es un lanzador real: el pill lo abre (data-command-open). */}
    <button type="button" class="hero__launch" data-command-open aria-label={t('home.launchAria')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <span class="hero__launch-text">{t('home.launch')}</span>
      <kbd class="hero__kbd">⌘K</kbd>
    </button>

    <ul class="hero__chips" role="list">
      {featured.map((m) => (
        <li>
          <a class="chip" href={m.href}>{m.label}</a>
        </li>
      ))}
    </ul>
  </section>

  {/* Below-fold: grid de feature-cards blancas sobre el lienzo crema. */}
  <section class="grid-section">
    <h2 class="grid-section__title">{t('home.allTools')}</h2>
    <ul class="modules" role="list">
      {
        items.map((m) => (
          <li>
            <a class="module" href={m.href}>
              <span class="module__text">
                <span class="module__title">{m.label}</span>
                <span class="module__desc">{m.description}</span>
              </span>
              <svg
                class="module__arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</main>

<style>
  .home {
    flex: 1;
    inline-size: 100%;
    max-inline-size: 60rem;
    margin-inline: auto;
    padding-inline: var(--spacing-m);
  }

  /* ---- Hero (input-as-hero) ---- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--spacing-3xl) var(--spacing-2xl);
  }

  .hero__eyebrow {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .hero__title {
    margin-block: var(--spacing-2xs) var(--spacing-l);
    font-size: var(--text-4xl);
  }

  /* Input de Cursor como lanzador: tarjeta blanca + hairline, radio 8px. */
  .hero__launch {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xs);
    inline-size: min(100%, 36rem);
    min-block-size: 3rem;
    padding-block: var(--spacing-2xs);
    padding-inline: var(--spacing-s) var(--spacing-xs);
    font: inherit;
    font-size: var(--text-base);
    color: var(--muted-foreground);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .hero__launch:hover {
    border-color: var(--border-strong);
  }

  .hero__launch:focus-visible {
    outline: none;
    border-color: var(--ring);
    box-shadow: var(--focus-halo);
  }

  .hero__launch svg {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    flex: none;
  }

  .hero__launch-text {
    flex: 1;
    text-align: start;
  }

  .hero__kbd {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    padding-block: 0.1rem;
    padding-inline: 0.4rem;
    color: var(--muted-foreground);
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs, 0.25rem);
  }

  .hero__chips {
    list-style: none;
    margin: var(--spacing-m) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2xs);
  }

  /* Chip de sugerencia: el único sitio de la home con pill (chips y badges). */
  .chip {
    display: inline-flex;
    align-items: center;
    padding-block: var(--spacing-3xs);
    padding-inline: var(--spacing-s);
    font-size: var(--text-sm);
    color: var(--foreground);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .chip:hover {
    border-color: var(--border-strong);
    background-color: var(--accent);
  }

  .chip:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* ---- Grid de herramientas ---- */
  .grid-section {
    padding-block-end: var(--spacing-2xl);
  }

  /* Caption en mayúsculas de Cursor como rótulo de sección. */
  .grid-section__title {
    margin: 0 0 var(--spacing-s);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--spacing-s);
  }

  /* Feature-card de Cursor: blanco sobre crema, hairline, radio 12px, sin sombra. */
  .module {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s);
    block-size: 100%;
    padding: var(--spacing-s) var(--spacing-m);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: var(--foreground);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .module:hover {
    border-color: var(--border-strong); /* hairline más firme en hover, sin sombra */
  }

  .module:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .module__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3xs);
  }

  .module__title {
    font-size: var(--text-base);
    font-weight: 500;
  }

  .module__desc {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  .module__arrow {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    flex: none;
    color: var(--muted-foreground);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .module:hover .module__arrow {
    transform: translateX(3px);
    color: var(--foreground);
  }
</style>
