---
// src/components/UnitsTool.astro — conversor de unidades multi-campo (isla cliente).
import { getLocale, useTranslations } from '../i18n/ui';
import { categoryIds } from '../lib/units';
const t = useTranslations(getLocale(Astro));
const cats = categoryIds.map((id) => ({ id, label: t(`units.${id}`) }));
---

<div class="units flow">
  <div class="units__tabs" role="tablist" aria-label={t('units.catAria')} data-tabs>
    {
      cats.map((c, i) => (
        <button
          type="button"
          role="tab"
          class:list={['units__tab', { 'is-active': i === 0 }]}
          data-cat={c.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {c.label}
        </button>
      ))
    }
  </div>

  <ul class="units__rows" data-rows role="list"></ul>

  <p class="units__hint">
    {t('units.hint')}
    <span class="units__msg" data-msg hidden>{t('common.copied')}</span>
  </p>
</div>

<style>
  .units__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2xs);
  }

  .units__tab {
    display: inline-flex;
    align-items: center;
    padding-block: var(--spacing-3xs);
    padding-inline: var(--spacing-m);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--foreground);
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 9999px;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .units__tab:hover {
    border-color: var(--foreground);
  }

  .units__tab.is-active {
    color: var(--primary-foreground);
    background-color: var(--primary);
    border-color: var(--primary);
  }

  .units__tab:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .units__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--spacing-2xs);
  }

  /* Filas creadas por JS → padre estático + :global(). */
  .units__rows :global(li) {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xs);
    padding: var(--spacing-2xs) var(--spacing-s);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .units__rows :global(.units__sym) {
    flex: none;
    inline-size: 2.75rem;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .units__rows :global(.units__in) {
    flex: 1;
    min-inline-size: 0;
    padding: var(--spacing-2xs);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--text-base);
    color: var(--foreground);
    background-color: var(--input);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .units__rows :global(.units__in:focus-visible) {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 30%, transparent);
  }

  .units__rows :global(.units__copy) {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    flex: none;
    display: inline-grid;
    place-items: center;
    color: var(--muted-foreground);
    background: none;
    border: 1px solid var(--border);
    border-radius: 9999px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .units__rows :global(.units__copy:hover) {
    color: var(--foreground);
    border-color: var(--foreground);
  }

  .units__rows :global(.units__copy svg) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .units__hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .units__msg {
    margin-inline-start: var(--spacing-2xs);
    color: var(--foreground);
  }
</style>

<script>
  import { unitList, convertAll, unitSymbol } from '../lib/units';

  const COPY_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

  function initUnits() {
    const root = document.querySelector<HTMLElement>('.units');
    const tabsEl = document.querySelector<HTMLElement>('[data-tabs]');
    const rowsEl = document.querySelector<HTMLElement>('[data-rows]');
    const msg = document.querySelector<HTMLElement>('[data-msg]');
    if (!root || !tabsEl || !rowsEl) return;

    let cat = 'length';
    let msgTimer = 0;

    // Redondeo a 8 cifras significativas para evitar ruido de coma flotante.
    function fmt(n: number): string {
      if (!Number.isFinite(n)) return '';
      return String(parseFloat(n.toPrecision(8)));
    }

    function renderRows(cat: string) {
      rowsEl!.replaceChildren(
        ...unitList(cat).map((u) => {
          const li = document.createElement('li');

          const sym = document.createElement('span');
          sym.className = 'units__sym';
          sym.textContent = unitSymbol[u] ?? u;

          const input = document.createElement('input');
          input.type = 'text';
          input.inputMode = 'decimal';
          input.className = 'units__in';
          input.dataset.unit = u;
          input.autocomplete = 'off';
          input.spellcheck = false;
          input.setAttribute('aria-label', unitSymbol[u] ?? u);

          const copy = document.createElement('button');
          copy.type = 'button';
          copy.className = 'units__copy';
          copy.dataset.copyUnit = u;
          copy.setAttribute('aria-label', 'Copiar');
          copy.innerHTML = COPY_ICON;

          li.append(sym, input, copy);
          return li;
        })
      );
    }

    function inputs(): HTMLInputElement[] {
      return Array.from(rowsEl!.querySelectorAll<HTMLInputElement>('.units__in'));
    }

    function convertFrom(el: HTMLInputElement) {
      const raw = el.value.trim().replace(',', '.');
      if (raw === '' || raw === '-' || raw === '.') {
        for (const other of inputs()) if (other !== el) other.value = '';
        return;
      }
      const value = Number(raw);
      if (!Number.isFinite(value)) return; // número a medio escribir
      const all = convertAll(cat, el.dataset.unit!, value);
      for (const other of inputs()) {
        if (other === el) continue; // no reformatea el campo que se edita
        other.value = fmt(all[other.dataset.unit!]);
      }
    }

    // Rellena todos desde una unidad y un valor (para el estado inicial).
    function seed(unit: string, value: number) {
      const all = convertAll(cat, unit, value);
      for (const el of inputs()) el.value = fmt(all[el.dataset.unit!]);
    }

    function selectCat(next: string) {
      cat = next;
      tabsEl!.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((tab) => {
        const on = tab.dataset.cat === next;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      renderRows(next);
      // Semilla razonable por categoría.
      const base = next === 'temperature' ? 'C' : unitList(next)[Math.min(1, unitList(next).length - 1)];
      seed(base, next === 'temperature' ? 20 : 1);
    }

    tabsEl.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement)?.closest<HTMLButtonElement>('[data-cat]');
      if (tab?.dataset.cat) selectCat(tab.dataset.cat);
    });

    rowsEl.addEventListener('input', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLInputElement>('.units__in');
      if (el) convertFrom(el);
    });

    rowsEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-copy-unit]');
      if (!btn) return;
      const input = rowsEl!.querySelector<HTMLInputElement>(`.units__in[data-unit="${btn.dataset.copyUnit}"]`);
      if (!input?.value) return;
      try {
        await navigator.clipboard.writeText(input.value);
        if (msg) {
          msg.hidden = false;
          clearTimeout(msgTimer);
          msgTimer = window.setTimeout(() => (msg.hidden = true), 1500);
        }
      } catch {}
    });

    selectCat('length');
  }

  // Con View Transitions, re-inicializar en cada carga/navegación.
  document.addEventListener('astro:page-load', initUnits);
</script>
