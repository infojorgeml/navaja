---
// src/components/Page.astro — shell de página reutilizable (cabecera + contenido centrado)
interface Props {
  title: string;
  lead?: string;
  size?: 'narrow' | 'wide';
}
const { title, lead, size = 'narrow' } = Astro.props;
---

<main class="page" data-size={size}>
  <div class="page__inner stack stack--page">
    <div class="page__head stack stack--field">
      <h1>{title}</h1>
      {lead && <p class="page__lead">{lead}</p>}
    </div>
    <slot />
  </div>
</main>

<style>
  /* Cada herramienta ocupa al menos toda la pantalla: el footer queda siempre por
     debajo del pliegue y no distrae mientras se trabaja. Solo lo usan las páginas
     de herramienta; la home no. */
  .page {
    flex: 1;
    min-block-size: 100vh;
    padding-block: var(--spacing-xl) var(--spacing-2xl);
    padding-inline: var(--spacing-m);
  }

  .page__inner {
    margin-inline: auto;
  }

  .page[data-size='narrow'] .page__inner {
    max-inline-size: 40rem;
  }

  .page[data-size='wide'] .page__inner {
    max-inline-size: 60rem;
  }

  .page__head h1 {
    margin: 0;
  }

  .page__lead {
    margin: 0;
    max-inline-size: var(--measure);
    color: var(--body-foreground);
    font-size: var(--text-lg);
  }
</style>
