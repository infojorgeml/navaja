---
// src/components/EpsTool.astro — conversor EPS → SVG (isla cliente).
// El intérprete (src/lib/eps.js) corre en un Web Worker; si no se puede crear, en el hilo principal.
import { getLocale, useTranslations } from '../i18n/ui';
const t = useTranslations(getLocale(Astro));
const noteCodes = [
  'tooComplex', 'infiniteLoop', 'empty', 'noBBox', 'raster',
  'shading', 'text', 'compressedAI', 'unknownOps', 'errors',
];
const strings = {
  ...Object.fromEntries(noteCodes.map((c) => [`note.${c}`, t(`eps.note.${c}`)])),
  'error.pdf': t('eps.error.pdf'),
  'error.notEps': t('eps.error.notEps'),
  'error.unknown': t('eps.error.unknown'),
  'error.read': t('eps.error.read'),
  failed: t('eps.failed'),
  noNotes: t('eps.noNotes'),
  converting: t('eps.converting'),
  status: t('eps.status'),
  previewAlt: t('eps.previewAlt'),
  truncated: t('eps.truncated'),
  factName: t('eps.factName'),
  factCreator: t('eps.factCreator'),
  factSize: t('eps.factSize'),
  factBBox: t('eps.factBBox'),
  factPaths: t('eps.factPaths'),
  factSvg: t('eps.factSvg'),
  noCreator: t('eps.noCreator'),
  sample: t('eps.sampleTag'),
  sampleName: t('eps.sampleName'),
  copied: t('eps.copied'),
  copyManual: t('eps.copyManual'),
};
---

<div class="eps stack stack--group" data-i18n={JSON.stringify(strings)}>
  <input type="file" accept=".eps,.epsf,.ps,application/postscript,application/eps" hidden data-file />

  <div class="eps__grid">
    <section class="eps__result" aria-label={t('eps.resultAria')}>
      <div class="eps__head">
        <div class="eps__seg" role="tablist" aria-label={t('eps.viewAria')}>
          <button type="button" role="tab" class="eps__pill" data-tab="prev" aria-selected="true" aria-controls="eps-view-prev">{t('eps.tabPreview')}</button>
          <button type="button" role="tab" class="eps__pill" data-tab="code" aria-selected="false" aria-controls="eps-view-code">{t('eps.tabCode')}</button>
        </div>
        <div class="eps__seg" role="group" aria-label={t('eps.bgAria')} data-bgsel>
          <button type="button" class="eps__pill" data-bg="checker" aria-pressed="true">{t('eps.bgChecker')}</button>
          <button type="button" class="eps__pill" data-bg="light" aria-pressed="false">{t('eps.bgLight')}</button>
          <button type="button" class="eps__pill" data-bg="dark" aria-pressed="false">{t('eps.bgDark')}</button>
        </div>
      </div>

      <div id="eps-view-prev" role="tabpanel">
        {/* El lienzo es también la zona de entrada: se suelta o se pulsa aquí mismo. */}
        <div class="eps__stage" data-stage data-bg="checker" data-drop={t('eps.dropRelease')}>
          <div class="eps__empty" data-empty>
            <p class="eps__empty-title">{t('eps.dropTitle')}</p>
            <p class="eps__empty-hint">{t('eps.dropHint')}</p>
            <p class="eps__empty-error" data-empty-error hidden></p>
            <div class="eps__empty-actions">
              <button type="button" class="btn btn--secondary" data-action="open">{t('eps.choose')}</button>
              <button type="button" class="eps__textbtn" data-action="sample">{t('eps.loadSample')}</button>
            </div>
          </div>
          <div class="eps__preview" data-preview hidden></div>
        </div>
      </div>
      <div id="eps-view-code" role="tabpanel" hidden>
        <textarea class="eps__code" data-code readonly spellcheck="false" aria-label={t('eps.codeAria')}></textarea>
      </div>

      <div class="eps__actions">
        <button type="button" class="btn" data-action="save" disabled>{t('eps.download')}</button>
        <button type="button" class="btn btn--secondary" data-action="copy" disabled>{t('eps.copy')}</button>
        <button type="button" class="btn btn--secondary" data-action="open" data-open-other hidden>{t('eps.openOther')}</button>
        <span class="eps__status" data-status role="status"></span>
      </div>
    </section>

    <aside class="eps__panel">
      <section class="eps__group">
        <h2 class="eps__title">{t('eps.settings')}</h2>
        <div class="eps__field">
          <span class="eps__label" id="eps-cmyk-label">{t('eps.cmyk')}</span>
          <div class="eps__seg eps__seg--wide" role="group" aria-labelledby="eps-cmyk-label" data-cmyk>
            <button type="button" class="eps__pill" data-v="standard" aria-pressed="true">{t('eps.cmykStandard')}</button>
            <button type="button" class="eps__pill" data-v="adobe" aria-pressed="false">{t('eps.cmykAdobe')}</button>
          </div>
          <small class="eps__hint">{t('eps.cmykHint')}</small>
        </div>
        <div class="eps__field">
          <label class="eps__label" for="eps-dec">{t('eps.decimals')}</label>
          <select id="eps-dec" class="eps__select">
            <option value="1">{t('eps.dec1')}</option>
            <option value="2">2</option>
            <option value="3" selected>3</option>
            <option value="4">{t('eps.dec4')}</option>
          </select>
        </div>
      </section>

      <section class="eps__group">
        <h2 class="eps__title">{t('eps.file')}</h2>
        <dl class="eps__facts" data-facts></dl>
      </section>

      <section class="eps__group">
        <h2 class="eps__title">{t('eps.notes')}</h2>
        <ul class="eps__notes" data-notes role="list" aria-live="polite"></ul>
      </section>

      <details class="eps__limits">
        <summary>{t('eps.limitsTitle')}</summary>
        <p><strong>{t('eps.limitsYesLabel')}</strong> {t('eps.limitsYes')}</p>
        <p><strong>{t('eps.limitsNoLabel')}</strong> {t('eps.limitsNo')}</p>
      </details>
    </aside>
  </div>
</div>

<style>
  /* ---- Segmentados (pills, como Calco y Unidades) ---- */
  .eps__seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--spacing-3xs);
  }

  .eps__seg--wide {
    display: flex;
  }

  .eps__seg--wide .eps__pill {
    flex: 1;
    justify-content: center;
  }

  .eps__pill {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
    padding-block: var(--spacing-3xs);
    padding-inline: var(--spacing-s);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--foreground);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .eps__pill:hover {
    border-color: var(--border-strong);
  }

  .eps__pill[aria-pressed='true'],
  .eps__pill[aria-selected='true'] {
    color: var(--primary-foreground);
    background-color: var(--primary);
    border-color: var(--primary);
  }

  .eps__pill:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* ---- Resultado + panel ---- */
  .eps__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: var(--spacing-m);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .eps__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .eps__result {
    display: grid;
    gap: var(--spacing-xs);
    min-inline-size: 0;
  }

  .eps__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-2xs) var(--spacing-s);
  }

  .eps__head [hidden] {
    display: none;
  }

  .eps__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: clamp(18rem, 56vh, 34rem);
    padding: var(--spacing-s);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: repeating-conic-gradient(var(--muted) 0 25%, var(--background) 0 50%) 0 0 / 18px 18px;
  }

  .eps__stage[data-bg='light'] {
    background: #ffffff;
  }

  .eps__stage[data-bg='dark'] {
    background: #101010;
  }

  /* Sin archivo, todo el lienzo invita a soltar o pulsar. */
  .eps__stage.is-empty {
    cursor: pointer;
  }

  .eps__stage.is-over::after {
    content: attr(data-drop);
    position: absolute;
    inset: var(--spacing-2xs);
    display: grid;
    place-items: center;
    font-weight: 500;
    color: var(--foreground);
    background-color: color-mix(in srgb, var(--background) 85%, transparent);
    border: 2px dashed var(--foreground);
    border-radius: var(--radius);
  }

  .eps__empty {
    display: grid;
    justify-items: center;
    gap: var(--spacing-2xs);
    max-inline-size: 24rem;
    padding: var(--spacing-m);
    text-align: center;
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .eps__empty[hidden],
  .eps__preview[hidden],
  .eps__empty-error[hidden] {
    display: none;
  }

  .eps__empty p {
    margin: 0;
  }

  .eps__empty-title {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .eps__empty-hint {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .eps__empty-error {
    font-size: var(--text-sm);
    color: var(--destructive);
  }

  .eps__empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2xs) var(--spacing-s);
    margin-block-start: var(--spacing-3xs);
  }

  /* Acción terciaria: texto subrayado, sin caja. */
  .eps__textbtn {
    padding: 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .eps__textbtn:hover {
    color: var(--foreground);
  }

  .eps__textbtn:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .eps__preview {
    inline-size: 100%;
    block-size: 100%;
  }

  /* La imagen de la vista previa se crea por JS → :global() bajo su padre estático. */
  .eps__preview :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .eps__code {
    display: block;
    inline-size: 100%;
    block-size: clamp(18rem, 56vh, 34rem);
    padding: var(--spacing-s);
    resize: vertical;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.55;
    white-space: pre;
    overflow: auto;
    tab-size: 2;
    color: var(--foreground);
    background-color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .eps__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2xs) var(--spacing-s);
  }

  .eps__actions .btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .eps__status {
    flex: 1 1 12rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  /* ---- Panel ---- */
  .eps__panel {
    display: grid;
    gap: var(--spacing-m);
    min-inline-size: 0;
  }

  .eps__group,
  .eps__field {
    display: grid;
    gap: var(--spacing-2xs);
  }

  .eps__group {
    gap: var(--spacing-xs);
  }

  .eps__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted-foreground);
  }

  .eps__label {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .eps__hint {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .eps__select {
    block-size: 2.25rem; /* control compacto: misma altura que pestañas e iconos */
    inline-size: 100%;
    padding-block: var(--spacing-3xs);
    padding-inline: var(--spacing-2xs);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--foreground);
    background-color: var(--input);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .eps__select:focus-visible {
    outline: none;
    border-color: var(--ring);
    box-shadow: var(--focus-halo);
  }

  /* Datos del archivo y avisos se pintan por JS → :global() bajo su padre estático. */
  .eps__facts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--spacing-3xs) var(--spacing-s);
    margin: 0;
    font-size: var(--text-sm);
  }

  .eps__facts :global(dt) {
    color: var(--muted-foreground);
  }

  .eps__facts :global(dd) {
    margin: 0;
    text-align: end;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .eps__facts :global(.is-mono) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .eps__notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-3xs);
  }

  .eps__notes :global(li) {
    padding: var(--spacing-2xs) var(--spacing-xs);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    background-color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .eps__notes :global(li.is-ok) {
    color: var(--muted-foreground);
    background-color: transparent;
  }

  .eps__notes :global(li.is-err) {
    color: var(--destructive);
    border-color: color-mix(in srgb, var(--destructive) 40%, transparent);
    background-color: color-mix(in srgb, var(--destructive) 8%, transparent);
  }

  .eps__limits {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    padding-block-start: var(--spacing-s);
    border-block-start: 1px solid var(--border);
  }

  .eps__limits summary {
    font-weight: 500;
    color: var(--foreground);
    cursor: pointer;
  }

  .eps__limits p {
    margin: var(--spacing-2xs) 0 0;
  }

  .eps__limits strong {
    font-weight: 500;
    color: var(--foreground);
  }
</style>

<script>
  import type { EpsNote, EpsOptions, EpsResult } from '../lib/eps.js';

  // EPS de ejemplo (dibujado a mano: CMYK, recortes, arcos, curvas y trazo con guiones).
  const SAMPLE =
    '%!PS-Adobe-3.0 EPSF-3.0\n%%Creator: Deftkit\n%%Title: Isla y olas\n%%BoundingBox: 0 0 320 200\n%%EndComments\n/rrect {\n  6 dict begin\n  /r exch def /h exch def /w exch def /y exch def /x exch def\n  newpath\n  x r add y r add r 180 270 arc\n  x w add r sub y r add r 270 360 arc\n  x w add r sub y h add r sub r 0 90 arc\n  x r add y h add r sub r 90 180 arc\n  closepath\n  end\n} def\n0.82 0.55 0 0.55 setcmykcolor\n0 0 320 200 rectfill\ngsave\n  12 12 296 176 20 rrect clip\n  0.98 0.93 0.78 setrgbcolor\n  12 12 296 176 rectfill\n  0 0.4 0.9 0 setcmykcolor\n  236 142 34 0 360 arc closepath fill\n  0 0.6 0.55 0.1 setcmykcolor\n  newpath 0 70 moveto 60 118 120 28 180 74 curveto 236 112 280 44 320 84 curveto 320 0 lineto 0 0 lineto closepath fill\n  0.85 0.2 0.35 0.05 setcmykcolor\n  newpath 0 44 moveto 70 84 130 6 190 46 curveto 240 80 290 20 320 52 curveto 320 0 lineto 0 0 lineto closepath fill\n  1 setgray 3 setlinewidth 1 setlinecap\n  newpath 18 96 moveto 70 128 120 70 176 100 curveto stroke\ngrestore\ngsave\n  0.1 setgray 2.5 setlinewidth [7 5] 0 setdash\n  12 12 296 176 20 rrect stroke\ngrestore\nshowpage\n';

  // El textarea de código se recorta: con SVG enormes el navegador se atasca.
  const CODE_LIMIT = 300_000;

  function initEps() {
    const root = document.querySelector<HTMLElement>('.eps');
    if (!root) return;

    const T = JSON.parse(root.dataset.i18n || '{}') as Record<string, string>;
    const lang = document.documentElement.lang || 'en';
    const nf = new Intl.NumberFormat(lang, { maximumFractionDigits: 1 });
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector<E>(sel)!;

    const stage = q('[data-stage]');
    const codeEl = q<HTMLTextAreaElement>('[data-code]');
    const factsEl = q('[data-facts]');
    const notesEl = q('[data-notes]');
    const statusEl = q('[data-status]');
    const fileEl = q<HTMLInputElement>('[data-file]');
    const emptyEl = q('[data-empty]');
    const emptyErr = q('[data-empty-error]');
    const previewEl = q('[data-preview]');
    const openOther = q('[data-open-other]');
    const decEl = document.getElementById('eps-dec') as HTMLSelectElement;
    const saveBtn = q<HTMLButtonElement>('[data-action="save"]');
    const copyBtn = q<HTMLButtonElement>('[data-action="copy"]');

    const state = {
      buf: null as ArrayBuffer | null,
      name: '',
      sample: true,
      svg: '',
      url: '',
      cmyk: 'standard' as NonNullable<EpsOptions['cmyk']>,
    };
    let reqId = 0;
    let busy = false;
    let worker: Worker | null = null;
    let local: typeof import('../lib/eps.js') | null = null;
    let msgTimer = 0;

    const ac = new AbortController();
    document.addEventListener(
      'astro:before-swap',
      () => {
        ac.abort();
        worker?.terminate();
        if (state.url) URL.revokeObjectURL(state.url);
      },
      { once: true }
    );

    /* ---------- motor ---------- */
    function startWorker() {
      try {
        const w = new Worker(new URL('../lib/eps.worker.js', import.meta.url), { type: 'module' });
        w.onmessage = (e) => onReply(e.data);
        w.onerror = () => {
          w.terminate();
          worker = null;
          busy = false;
          run();
        };
        return w;
      } catch {
        return null;
      }
    }
    worker = startWorker();

    function onReply(m: { id: number; result?: EpsResult; error?: string }) {
      busy = false;
      if (m.id !== reqId) return;
      if (m.result) render(m.result);
      else renderError(T[`error.${m.error}`] || T['error.unknown']);
    }

    async function run() {
      if (!state.buf) return;
      const id = ++reqId;
      const opt: EpsOptions = { cmyk: state.cmyk, decimals: parseInt(decEl.value, 10) };
      statusEl.textContent = T.converting;
      if (worker) {
        // Si el anterior sigue atascado en un EPS pesado, se descarta y se arranca otro.
        if (busy) {
          worker.terminate();
          worker = startWorker();
        }
        if (worker) {
          busy = true;
          worker.postMessage({ id, buf: state.buf, opt });
          return;
        }
      }
      local ??= await import('../lib/eps.js');
      if (id !== reqId) return;
      try {
        render(local.convertEPS(state.buf, opt));
      } catch (err) {
        renderError(T[`error.${(err as { code?: string }).code}`] || T['error.unknown']);
      }
    }

    /* ---------- salida ---------- */
    const fmtBytes = (n: number) =>
      n < 1024 ? `${n} B` : n < 1048576 ? `${nf.format(n / 1024)} KB` : `${nf.format(n / 1048576)} MB`;
    const outName = () => state.name.replace(/\.(eps|epsf|ps)$/i, '') + '.svg';

    function setFacts(rows: [string, string, boolean?][]) {
      factsEl.replaceChildren(
        ...rows.flatMap(([k, v, mono]) => {
          const dt = document.createElement('dt');
          dt.textContent = k;
          const dd = document.createElement('dd');
          dd.textContent = v;
          if (mono) dd.className = 'is-mono';
          return [dt, dd];
        })
      );
    }

    function setNotes(items: string[], kind = '') {
      notesEl.replaceChildren(
        ...items.map((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          if (kind) li.className = kind;
          return li;
        })
      );
    }

    const noteText = (n: EpsNote) =>
      (T[`note.${n.code}`] || n.code).replace('{n}', String(n.n ?? '')).replace('{ops}', n.ops ?? '');

    // Sin resultado se ve el estado vacío (soltar / elegir); con resultado, la vista previa.
    function showEmpty(error = '') {
      emptyErr.textContent = error;
      emptyErr.hidden = !error;
      emptyEl.hidden = false;
      previewEl.hidden = true;
      previewEl.replaceChildren();
      stage.classList.add('is-empty');
      openOther.hidden = true;
    }

    function render(r: EpsResult) {
      state.svg = r.svg;
      if (state.url) URL.revokeObjectURL(state.url);
      state.url = URL.createObjectURL(new Blob([r.svg], { type: 'image/svg+xml' }));
      // <img> y no innerHTML: el SVG viene de un archivo ajeno y así nunca ejecuta nada.
      const img = document.createElement('img');
      img.alt = T.previewAlt;
      img.src = state.url;
      previewEl.replaceChildren(img);
      previewEl.hidden = false;
      emptyEl.hidden = true;
      emptyErr.hidden = true;
      stage.classList.remove('is-empty');
      openOther.hidden = false;
      codeEl.value =
        r.svg.length > CODE_LIMIT ? `${r.svg.slice(0, CODE_LIMIT)}\n\n<!-- ${T.truncated} -->` : r.svg;
      setFacts([
        [T.factName, state.sample ? `${state.name} (${T.sample})` : state.name],
        [T.factCreator, r.creator || T.noCreator],
        [T.factSize, `${nf.format(r.width)} × ${nf.format(r.height)} pt`],
        [T.factBBox, r.bbox.map((v) => nf.format(v)).join(' '), true],
        [T.factPaths, r.paths.toLocaleString(lang)],
        [T.factSvg, fmtBytes(new Blob([r.svg]).size)],
      ]);
      if (r.notes.length) setNotes(r.notes.map(noteText));
      else setNotes([T.noNotes], 'is-ok');
      statusEl.textContent = T.status;
      saveBtn.disabled = copyBtn.disabled = false;
    }

    function renderError(msg: string) {
      state.svg = '';
      showEmpty(T.failed);
      codeEl.value = '';
      setFacts([[T.factName, state.name]]);
      setNotes([msg], 'is-err');
      statusEl.textContent = '';
      saveBtn.disabled = copyBtn.disabled = true;
    }

    /* ---------- entrada ---------- */
    function loadSample() {
      state.buf = new TextEncoder().encode(SAMPLE).buffer as ArrayBuffer;
      state.name = T.sampleName;
      state.sample = true;
      run();
    }

    function loadFile(file?: File | null) {
      if (!file) return;
      file.arrayBuffer().then(
        (buf) => {
          state.buf = buf;
          state.name = file.name;
          state.sample = false;
          run();
        },
        () => {
          state.name = file.name;
          renderError(T['error.read']);
        }
      );
    }

    fileEl.addEventListener('change', () => {
      loadFile(fileEl.files?.[0]);
      fileEl.value = '';
    });
    // El lienzo acepta archivos siempre: vacío para empezar, con resultado para reemplazarlo.
    for (const ev of ['dragenter', 'dragover']) {
      stage.addEventListener(ev, (e) => {
        e.preventDefault();
        stage.classList.add('is-over');
      });
    }
    stage.addEventListener('dragleave', (e) => {
      if (!stage.contains((e as DragEvent).relatedTarget as Node)) stage.classList.remove('is-over');
    });
    stage.addEventListener('drop', (e) => {
      e.preventDefault();
      stage.classList.remove('is-over');
      loadFile(e.dataTransfer?.files[0]);
    });
    // Soltar fuera del lienzo no debe abrir el archivo en la pestaña.
    window.addEventListener('dragover', (e) => e.preventDefault(), { signal: ac.signal });
    window.addEventListener('drop', (e) => e.preventDefault(), { signal: ac.signal });

    decEl.addEventListener('change', run);

    /* ---------- pestañas, fondo, CMYK y acciones ---------- */
    function press(group: Element, btn: Element) {
      for (const b of group.children) b.setAttribute('aria-pressed', String(b === btn));
    }

    function showTab(code: boolean) {
      for (const b of root!.querySelectorAll<HTMLElement>('[data-tab]'))
        b.setAttribute('aria-selected', String((b.dataset.tab === 'code') === code));
      document.getElementById('eps-view-prev')!.hidden = code;
      document.getElementById('eps-view-code')!.hidden = !code;
      q('[data-bgsel]').hidden = code;
    }

    root.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      const tab = el.closest<HTMLElement>('[data-tab]');
      if (tab) return showTab(tab.dataset.tab === 'code');

      const bg = el.closest<HTMLElement>('[data-bg]');
      if (bg && bg !== stage) {
        press(q('[data-bgsel]'), bg);
        stage.dataset.bg = bg.dataset.bg;
        return;
      }

      const cm = el.closest<HTMLElement>('[data-cmyk] [data-v]');
      if (cm) {
        press(q('[data-cmyk]'), cm);
        if (cm.dataset.v !== state.cmyk) {
          state.cmyk = cm.dataset.v as typeof state.cmyk;
          run();
        }
        return;
      }

      const action = el.closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'sample') return loadSample();
      if (action === 'open') return fileEl.click();
      // Pulsar en cualquier parte del lienzo vacío también abre el selector.
      if (!action && stage.classList.contains('is-empty') && stage.contains(el)) return fileEl.click();
      if (!state.svg) return;
      if (action === 'save') {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([state.svg], { type: 'image/svg+xml' }));
        a.download = outName();
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      } else if (action === 'copy') {
        const flash = (text: string) => {
          statusEl.textContent = text;
          clearTimeout(msgTimer);
          msgTimer = window.setTimeout(() => (statusEl.textContent = T.status), 2400);
        };
        const fallback = () => {
          showTab(true);
          codeEl.focus();
          codeEl.select();
          flash(T.copyManual);
        };
        try {
          navigator.clipboard.writeText(state.svg).then(() => flash(T.copied), fallback);
        } catch {
          fallback();
        }
      }
    });

    showEmpty();
  }

  // Con View Transitions, re-inicializar en cada carga/navegación.
  document.addEventListener('astro:page-load', initEps);
</script>
