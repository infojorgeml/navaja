---
// src/components/Header.astro — marca + buscador ⌘K + selector de idioma + tema.
// La navegación entre módulos vive en la home (índice) y en el command palette.
import { getRelativeLocaleUrl } from 'astro:i18n';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import { getLocale, useTranslations, localizedBasePath } from '../i18n/ui';

const locale = getLocale(Astro);
const t = useTranslations(locale);
// Cada idioma tiene su slug (/counter ↔ /es/contador): se traduce la ruta actual.
const esUrl = getRelativeLocaleUrl('es', localizedBasePath(Astro.url.pathname, locale, 'es'));
const enUrl = getRelativeLocaleUrl('en', localizedBasePath(Astro.url.pathname, locale, 'en'));
const brandUrl = getRelativeLocaleUrl(locale, '');
---

<header class="header">
  <div class="header__inner boxed">
    <a class="header__brand" href={brandUrl}><Logo /></a>

    <div class="header__right">
      <button
        type="button"
        class="header__search"
        data-command-open
        aria-label={t('chrome.searchAria')}
        aria-keyshortcuts="Meta+K Control+K"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="header__search-label">{t('chrome.search')}</span>
        <kbd class="header__kbd">⌘K</kbd>
      </button>

      <div class="lang" role="group" aria-label={t('chrome.langAria')}>
        <a class="lang__opt" href={enUrl} aria-current={locale === 'en' ? 'true' : 'false'} hreflang="en">EN</a>
        <a class="lang__opt" href={esUrl} aria-current={locale === 'es' ? 'true' : 'false'} hreflang="es">ES</a>
      </div>

      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    border-block-end: 1px solid var(--border);
    background-color: color-mix(in oklab, var(--background) 80%, transparent);
    backdrop-filter: blur(10px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s);
    block-size: 4rem;
  }

  /* Logotipo de Jorge (src/components/Logo.astro): solo se escala, no se rediseña. */
  .header__brand {
    --logo-size: 1.625rem;
    display: inline-flex;
    align-items: center;
    color: var(--foreground);
    text-decoration: none;
  }

  .header__brand:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: 2px;
  }


  .header__right {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xs);
  }

  /* Buscador como input compacto: tarjeta + hairline, radio 8px (input de Cursor). */
  .header__search {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2xs);
    block-size: 2.25rem;
    padding-inline: var(--spacing-xs) 0.375rem;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .header__search:hover {
    color: var(--foreground);
    border-color: var(--border-strong);
  }

  .header__search:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .header__search svg {
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
  }

  .header__search-label,
  .header__kbd {
    display: none;
  }

  .header__kbd {
    margin-inline-start: var(--spacing-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    padding-block: 0.1rem;
    padding-inline: 0.35rem;
    color: var(--muted-foreground);
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs, 0.25rem);
  }

  /* Selector de idioma: control segmentado de radio 8px (activo = tinta). */
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    block-size: 2.25rem;
    padding: 3px;
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .lang__opt {
    display: inline-flex;
    align-items: center;
    block-size: 100%;
    padding-inline: 0.5rem;
    font-size: var(--text-2xs);
    font-weight: 500;
    line-height: 1;
    color: var(--muted-foreground);
    text-decoration: none;
    border-radius: calc(var(--radius) - 3px);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .lang__opt:hover {
    color: var(--foreground);
  }

  .lang__opt[aria-current='true'] {
    color: var(--primary-foreground);
    background-color: var(--primary);
  }

  .lang__opt:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .header__search-label,
    .header__kbd {
      display: inline-block;
    }
  }
</style>
