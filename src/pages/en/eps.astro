---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Page from '../../components/Page.astro';
import EpsTool from '../../components/EpsTool.astro';
import { getLocale, useTranslations } from '../../i18n/ui';
const t = useTranslations(getLocale(Astro));
---

<BaseLayout title={t('tool.eps.title')} description={t('tool.eps.lead')}>
  <Page title={t('tool.eps.title')} lead={t('tool.eps.lead')} size="wide">
    <EpsTool />
  </Page>
</BaseLayout>
