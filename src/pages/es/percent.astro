---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Page from '../../components/Page.astro';
import PercentTool from '../../components/PercentTool.astro';
import { getLocale, useTranslations } from '../../i18n/ui';
const t = useTranslations(getLocale(Astro));
---

<BaseLayout title={t('tool.percent.title')} description={t('tool.percent.lead')}>
  <Page title={t('tool.percent.title')} lead={t('tool.percent.lead')} size="wide">
    <PercentTool />
  </Page>
</BaseLayout>
